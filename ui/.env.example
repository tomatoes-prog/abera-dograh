BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
# Port the dev server binds. Leave unset for Next's default (3000, auto-
# incrementing if busy). scripts/worktree-sync-env.sh sets this per git worktree
# and points the backend's CORS_ALLOWED_ORIGINS + UI_APP_URL at it.
# UI_PORT=3000
# Base URL of the user-facing app, used for superadmin impersonation redirects
# (defaults to the current origin when unset)
# NEXT_PUBLIC_APP_URL=http://localhost:3010
NEXT_PUBLIC_NODE_ENV=development
# Optional external telemetry. Disabled unless explicitly set to true in the UI server env.
ENABLE_TELEMETRY=false
POSTHOG_KEY=
POSTHOG_HOST=https://us.posthog.com
SENTRY_DSN=
# Optional build-only Sentry source-map upload. Provide all three values only
# when explicitly publishing this build's source maps to your own Sentry project.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# Optional external integrations. Blank values disable the browser support widget
# and remote lead/onboarding submissions.
CHATWOOT_URL=
CHATWOOT_WEBSITE_TOKEN=
ONBOARDING_API_URL=
# Optional analytics integrations, loaded only when ENABLE_TELEMETRY=true.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
# Dograh Cloud only - shows the current event banner; not loaded when blank
NEXT_PUBLIC_EVENT_BANNER=
